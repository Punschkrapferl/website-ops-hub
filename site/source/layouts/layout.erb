<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />

   <!-- Inject admin token for demo-only UI actions (e.g. reset events) -->
    <meta name="admin-token" content="<%= ENV['ADMIN_TOKEN'] || '' %>" />

    <title><%= current_page.data.title || "Website Ops Hub" %></title>
    <meta name="description" content="Static website + integrations + automation with observable data flows." />

    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <%= stylesheet_link_tag "site" %>
  </head>

  <body class="app-body">
    <header class="app-header border-bottom">
      <nav class="navbar navbar-expand-lg" data-bs-theme="dark">
        <div class="container py-2">
          <a class="navbar-brand d-flex align-items-center gap-2" href="/">
            <span class="brand-mark"><i class="bi bi-nodes"></i></span>
            <span class="fw-semibold">Website Ops Hub</span>
          </a>

          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
            <span class="navbar-toggler-icon"></span>
          </button>

          <div id="nav" class="collapse navbar-collapse">
            <div class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
              <a class="nav-link" href="/events.html">Events</a>
              <a class="nav-link" href="/contact.html">Contact</a>
              <a class="btn btn-sm btn-primary ms-lg-2" href="/contact.html">
                <i class="bi bi-send me-1"></i> Submit a lead
              </a>
            </div>
          </div>
        </div>
      </nav>
    </header>

    <main class="container py-5">
      <%= yield %>
    </main>

    <footer class="app-footer">
      <div class="container py-4 d-flex flex-column flex-md-row gap-2 align-items-md-center justify-content-between">
        <div class="d-flex gap-3 small">
          <a class="link-muted" href="/">Home</a>
          <a class="link-muted" href="/events.html">Events</a>
          <a class="link-muted" href="/contact.html">Contact</a>
        </div>
      </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <%= javascript_include_tag "app" %>
  </body>
</html>
