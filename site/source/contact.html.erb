---
title: Contact
---

<div class="row g-4 align-items-start">
  <div class="col-lg-5">
    <div class="panel p-4">
      <div class="d-flex align-items-center justify-content-between">
        <div class="fw-semibold">Pipeline status</div>
        <span id="healthBadge" class="badge text-bg-secondary rounded-pill">Checking…</span>
      </div>

      <hr class="soft my-3" />

      <div class="muted mb-3">
        Submitting this form triggers a validated lead ingestion, persistence, and a couple of integration steps.
        Then it shows up in the events feed.
      </div>

      <div class="row g-3">
        <div class="col-6">
          <div class="muted small">Latest events</div>
          <div class="fs-3 fw-bold" id="eventsCount">0</div>
        </div>
        <div class="col-6">
          <div class="muted small">Last event</div>
          <div class="small" id="lastEventTime">n/a</div>
        </div>
      </div>

      <div class="mt-3">
        <a class="btn btn-outline-light w-100" href="/events.html">
          <i class="bi bi-activity me-2"></i> View events
        </a>
      </div>
    </div>
  </div>

  <div class="col-lg-7">
    <div class="panel panel-strong p-4">
      <h1 class="h3 fw-bold mb-1">Contact</h1>
      <div class="muted mb-4">Send a lead through the pipeline.</div>

      <div id="alert" class="alert d-none" role="alert"></div>

      <form id="leadForm" class="d-grid gap-3" novalidate>
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label muted">Name</label>
            <input class="form-control" name="name" placeholder="Optional" autocomplete="name" />
          </div>
          <div class="col-md-6">
            <label class="form-label muted">Email *</label>
            <input
              class="form-control"
              type="email"
              name="email"
              placeholder="Required"
              autocomplete="email"
              required
            />
          </div>
        </div>

        <div>
          <label class="form-label muted">Company</label>
          <input class="form-control" name="company" placeholder="Optional" autocomplete="organization" />
        </div>

        <div>
          <label class="form-label muted">Message</label>
          <textarea class="form-control" name="message" rows="5" placeholder="Optional"></textarea>
        </div>

        <button class="btn btn-primary btn-lg" type="submit">
          <i class="bi bi-send me-2"></i> Send
        </button>

        <div class="muted small">
          Tip: submitting twice with the same email+message triggers idempotency and returns success as duplicate.
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  (() => {
    const isDevPage = window.location.port === "4567";
    const apiBasePage = isDevPage ? "http://localhost:8080" : "";
    const leadUrl = `${apiBasePage}/api/lead`;

    const form = document.getElementById("leadForm");
    const alertBox = document.getElementById("alert");

    function showAlert(type, msg) {
      alertBox.className = `alert alert-${type}`;
      alertBox.textContent = msg;
      alertBox.classList.remove("d-none");
    }

    async function sha256Hex(text) {
      if (!window.crypto?.subtle) return null;
      const enc = new TextEncoder().encode(text);
      const buf = await window.crypto.subtle.digest("SHA-256", enc);
      return Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2, "0")).join("");
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      alertBox.classList.add("d-none");

      const fd = new FormData(form);
      const payload = Object.fromEntries(fd.entries());

      // Trim and drop empty optional fields so backend sees "missing" instead of "".
      for (const k of Object.keys(payload)) {
        const v = String(payload[k] ?? "").trim();
        if (v === "") delete payload[k];
        else payload[k] = v;
      }

      if (!payload.email) {
        showAlert("danger", "Email is required.");
        return;
      }

      const email = String(payload.email);
      const msg = String(payload.message ?? "");
      const idemBase = `${email}::${msg}`;

      const idemHash = await sha256Hex(idemBase);
      const idempotencyKey = idemHash
        ? `lead_${idemHash}`
        : `lead_${idemBase.replace(/[^A-Za-z0-9._-]/g, "_").slice(0, 120)}`;

      try {
        const res = await fetch(leadUrl, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "Idempotency-Key": idempotencyKey
          },
          body: JSON.stringify(payload)
        });

        const ct = res.headers.get("content-type") || "";
        const data = ct.includes("application/json") ? await res.json() : null;

        if (!res.ok) throw new Error(data?.error || `Request failed (HTTP ${res.status})`);

        showAlert("success", data?.duplicate ? "Already received. Thank you." : "Sent. Thank you.");
        form.reset();
      } catch (err) {
        showAlert("danger", err?.message || "Something went wrong");
      }
    });
  })();
</script>
